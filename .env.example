# Copy this file to .env for local testing, or set these as environment
# variables in your hosting provider's dashboard (Render/Railway/etc).
# Never commit a real .env file.

# Generated once, printed to you by Claude. The PUBLIC key also needs to be
# pasted into shift_alarm_v3.html's VAPID_PUBLIC_KEY constant.
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:your-email@example.com

# From upstash.com — Redis database → REST API section.
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
